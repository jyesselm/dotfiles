live:
  vaults:
  - ~/local/code/web/notes/notes
  roots:
  - ~/Downloads
  - ~/Documents
  - ~/Desktop
  - ~/Dropbox
  - ~/Library/CloudStorage/Dropbox
  - ~/cloud/Dropbox
  - ~/cloud/gdrive
  - ~/local
  mail_source: thunderbird
  mail_roots: []
  mail_database: ~/.cache/search-cli/thunderbird-v1.sqlite3
