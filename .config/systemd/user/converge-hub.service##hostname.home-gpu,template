[Unit]
Description=converge hub: fleet check-ins on 127.0.0.1:8790 (tailscale serve --set-path /converge)

[Service]
ExecStart=%h/.config/yadm/setup/hub.py serve
Environment=PATH=%h/.local/bin:/usr/bin:/bin
# Files pending recipes as chains in the Tasks app (project Computers); comment out to turn off:
Environment=CONVERGE_TASKS=http://100.73.70.25:8767
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
