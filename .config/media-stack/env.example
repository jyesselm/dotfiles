# Copy to .env (untracked) and fill in. Values below are the Mac Plex server's.
# User/group that owns the media and config files (macOS: id -u / id -g; Linux: usually 1000/1000).
PUID=501
PGID=20
TZ=America/Chicago

# Host path of the media disk (Linux example: /mnt/plex).
MEDIA_ROOT=/Volumes/Plex_Disk_4
# Host folder holding each app's config/database (copy this whole folder when migrating).
DATA_ROOT=/Users/jyesselm/.local/share
# Plex's Databases folder; media-index reads watch history from its dated backups.
# Linux: $DATA_ROOT/plex/config/Library/Application Support/Plex Media Server/Plug-in Support/Databases
PLEX_DB_DIR="/Users/jyesselm/Library/Application Support/Plex Media Server/Plug-in Support/Databases"

# How containers reach Plex while it runs on the host itself.
# OrbStack: 0.250.250.254 (a name like host.internal is rejected by some apps). Linux: the host's LAN IP,
# or drop it once Plex runs in this compose file too (see README.md).
HOST_ADDR=0.250.250.254
# Addresses you open the dashboard from, comma-separated, with port.
HOMEPAGE_ALLOWED_HOSTS=plex-server.tail2813f4.ts.net,localhost:3000,192.168.4.26:3000,plex-server.local:3000,plex-server.tail2813f4.ts.net:3000,100.120.188.110:3000

# Host the dashboard's links open: the Tailscale name works at home and away (devices need Tailscale).
HOMEPAGE_VAR_LINK_HOST=plex-server.tail2813f4.ts.net

# API keys for dashboard tiles (Settings > General in each app; Seerr: Settings > General > API Key).
HOMEPAGE_VAR_RADARR_KEY=
HOMEPAGE_VAR_SONARR_KEY=
HOMEPAGE_VAR_LIDARR_KEY=
HOMEPAGE_VAR_PROWLARR_KEY=
HOMEPAGE_VAR_SEERR_KEY=
# Audiobookshelf: Settings > API Keys (admin).
HOMEPAGE_VAR_AUDIOBOOKSHELF_KEY=
# Plex token: see https://support.plex.tv/articles/204059436 (paste it yourself).
HOMEPAGE_VAR_PLEX_TOKEN=

# NordVPN WireGuard (NordLynx) private key for gluetun: Nord Account > NordVPN > Manual setup > Set up NordVPN manually,
# get an access token, then follow gluetun's NordVPN page to turn it into the private key. Paste it yourself.
NORDVPN_WIREGUARD_KEY=
# Countries to pick VPN servers from, comma-separated.
VPN_COUNTRIES=United States

# RomM (games). Generate each secret with: openssl rand -hex 32
ROMM_DB_PASSWORD=
ROMM_DB_ROOT_PASSWORD=
ROMM_AUTH_SECRET_KEY=
# Optional metadata: IGDB (Twitch developer app, unique name) and a ScreenScraper account.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
SCREENSCRAPER_USER=
SCREENSCRAPER_PASSWORD=

# Sonobarr (music discovery). Secret and admin password: openssl rand -hex 32 / openssl rand -base64 18.
# Last.fm key and secret: https://www.last.fm/api/account/create (any app name; callback URL can be blank). Paste them yourself.
SONOBARR_SECRET_KEY=
SONOBARR_ADMIN_PASSWORD=
LASTFM_API_KEY=
LASTFM_API_SECRET=
