# Server class (Plex server): the terminal Brewfile plus the terminal app and the keyboard remapper so the keyboard behaves the same.
cask "karabiner-elements"
cask "iterm2"

cask "orbstack"

# Re-encoding shrink-marked titles with the hardware HEVC encoder (media-stack/media-index/shrink.py).
brew "ffmpeg"

# Drive health checks for the media and backup drives (smartctl).
brew "smartmontools"
