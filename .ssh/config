# Added by OrbStack: 'orb' SSH host for Linux machines
# This only works if it's at the top of ssh_config (before any Host blocks).
# This won't be added again if you remove it.
Include ~/.orbstack/ssh/config

ServerAliveInterval 900
ServerAliveCountMax 0
Include ~/.colima/ssh_config

Host swan
    HostName swan.unl.edu
    User jyesselm
    
Host nas
    HostName yesselmanbackup   # Tailscale MagicDNS name; on campus also yesselmanbackup.unl.edu
    User jyesselm
    ForwardAgent yes

Host mac-desktop
    HostName mac-studio   # Tailscale MagicDNS name; LAN was 10.72.66.207
    User jyesselman2

Host plex-server
    HostName plex-server   # Tailscale MagicDNS name
    User jyesselm

Host home-gpu
    HostName 100.103.114.116
    User yesselman

Host *
    # the mscp baseline in /etc/ssh/ssh_config.d limits clients to ECDSA; my keys are ed25519
    PubkeyAcceptedAlgorithms +ssh-ed25519
    ServerAliveInterval 60
    ServerAliveCountMax 3
    ControlMaster auto
    ControlPath /tmp/%r@%h:%p
    ControlPersist 12h
    # 1Password SSH Agent (Touch ID for SSH auth)
    IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
