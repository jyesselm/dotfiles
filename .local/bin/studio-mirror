#!/bin/bash
# Nightly mirror of the Studio's own data to nrdstor (lab-data consolidation, decision N, 2026-11-02):
# ~/local/data, ~/local/code and ~/Downloads go to swan:/mnt/nrdstor/yesselmanlab/jyesselm/studio/<same path under ~>.
# A file deleted or changed here is not dropped on nrdstor: rsync parks the old copy under studio-deleted/<date>/.
# Caches (.cache, node_modules, __pycache__, virtualenvs) are rebuildable and never mirrored (decision O).
# Runs from the LaunchAgent com.jyesselman.studio-mirror at 02:00; log: ~/.local/state/studio-mirror/mirror.log.
set -u
REMOTE=swan
ROOT=/mnt/nrdstor/yesselmanlab/jyesselm/studio
LOG=$HOME/.local/state/studio-mirror/mirror.log
mkdir -p "$(dirname "$LOG")"
exec >>"$LOG" 2>&1
echo "=== start $(date -Iseconds)"
[ -e "$(dirname "$LOG")/paused" ] && { echo "paused ($(cat "$(dirname "$LOG")/paused")); skipping"; exit 0; }
ssh -o BatchMode=yes "$REMOTE" mkdir -p "$ROOT/local/data" "$ROOT/local/code" "$ROOT/Downloads" "${ROOT}-deleted" || { echo "cannot reach $REMOTE"; echo "=== end $(date -Iseconds) rc=255"; exit 255; }
rc=0
for d in local/data local/code Downloads; do
  rsync -a --delete --backup --backup-dir="${ROOT}-deleted/$(date +%F)/$d" \
    --exclude .DS_Store --exclude node_modules --exclude __pycache__ --exclude '*.pyc' --exclude .venv --exclude venv \
    --exclude .cache --exclude .ipynb_checkpoints --exclude .Trash \
    --stats "$HOME/$d/" "$REMOTE:$ROOT/$d/" | grep -E 'Number of (regular files transferred|deleted files)|Total transferred file size|rsync error'
  r=${PIPESTATUS[0]}; echo "$d rc=$r"; [ "$r" -ne 0 ] && rc=$r
done
echo "=== end $(date -Iseconds) rc=$rc"
