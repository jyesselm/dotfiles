<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.jyesselman.rna-knowledge-base-index</string>
  <key>ProgramArguments</key><array>
    <string>/opt/homebrew/Caskroom/mambaforge/base/envs/py3/bin/python</string><string>-u</string>
    <string>/Users/jyesselman2/local/data/rna-knowledge-base/nightly_index_update.py</string><string>run</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/jyesselman2/local/data/rna-knowledge-base</string>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>4</integer><key>Minute</key><integer>15</integer></dict>
  <key>StandardOutPath</key><string>/Users/jyesselman2/local/data/rna-knowledge-base/harvest_logs/nightly-index-update.log</string>
  <key>StandardErrorPath</key><string>/Users/jyesselman2/local/data/rna-knowledge-base/harvest_logs/nightly-index-update.log</string>
  <key>LowPriorityIO</key><true/>
  <key>Nice</key><integer>10</integer>
</dict></plist>
