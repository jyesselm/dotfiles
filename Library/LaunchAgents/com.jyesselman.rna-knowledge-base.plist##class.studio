<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.jyesselman.rna-knowledge-base</string>
  <key>ProgramArguments</key><array><string>/opt/homebrew/Caskroom/mambaforge/base/envs/py3/bin/python3</string><string>-m</string><string>rna_knowledge_base</string><string>serve</string><string>--port</string><string>8770</string></array>
